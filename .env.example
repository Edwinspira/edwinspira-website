# Site (optional)
NEXT_PUBLIC_SITE_URL=

# Sanity CMS (required for /studio and content fetching)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2025-05-20

# Server-only: draft/preview reads (optional until draft mode is enabled)
SANITY_API_READ_TOKEN=

# Contact form email (server-only; required to deliver inquiries)
RESEND_API_KEY=
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=edwin@edwinspira.com

# Google Cloud reCAPTCHA Enterprise (score-based)
# Site key is public. API key and project ID are server-only.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_API_KEY=
RECAPTCHA_PROJECT_ID=
RECAPTCHA_MIN_SCORE=0.5

# Optional durable rate limiting (Upstash Redis REST)
# Without these, the contact endpoint uses in-memory limits (unreliable on Vercel).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
